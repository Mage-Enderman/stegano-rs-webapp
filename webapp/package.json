{
  "name": "Stegano Web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "wasm": "wasm-pack build ../crates/stegano-wasm --target web --out-dir ../../webapp/src/pkg --release",
    "wasm:dev": "wasm-pack build ../crates/stegano-wasm --target web --out-dir ../../webapp/src/pkg --dev",
    "wasm:jxl": "wasm-pack build ../crates/stegano-wasm --target web --out-dir ../../webapp/src/pkg --release --features jxl-encode"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "jszip": "^3.10.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "vite-plugin-pwa": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
